{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": []
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "bridge/store.ts",
    "bridge/handler.ts",
    "bridge/vite.ts",
    "bridge/server.ts",
    "bridge/cli.ts",
    "bridge/*.node.test.ts"
  ]
}
